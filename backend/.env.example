# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/examify

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_too
JWT_EXPIRE=2h
JWT_REFRESH_EXPIRE=7d

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=Examify <noreply@examify.com>

# Frontend URL (for CORS & email links)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://test-online-azeems-projects-2dc3ba39.vercel.app
CORS_ORIGIN_REGEX=^https://[a-z0-9-]+\\.vercel\\.app$
# Proctoring
SCREENSHOT_INTERVAL=30000
MAX_VIOLATIONS=3
 

AUTH_ALERT_WEBHOOK_URL=
AUTH_ALERT_WEBHOOK_URL=
SUPERADMIN_SETUP_SECRET=replace_with_long_random_secret
SUPERADMIN_BOOTSTRAP_IP_ALLOWLIST=127.0.0.1,::1
SUPERADMIN_NAME=Platform Owner
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_PASSWORD=change_me